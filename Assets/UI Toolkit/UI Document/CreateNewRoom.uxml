<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Style%20Sheet/Default/General.uss?fileID=7433441132597879392&amp;guid=22fc223e51bc6e64db8efffca69c7b98&amp;type=3#General" />
    <Style src="project://database/Assets/UI%20Toolkit/Style%20Sheet/Default/CreateRoom.uss?fileID=7433441132597879392&amp;guid=e9ab5d38d555edb4899d7877c93e0320&amp;type=3" />
    <ui:VisualElement name="background" class="text-element" style="flex-grow: 1; justify-content: center;">
        <ui:VisualElement name="game-setting" style="flex-grow: 0; align-self: center; width: 90%; padding-top: 50px; padding-right: 50px; padding-bottom: 50px; padding-left: 50px; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center;">
                <ui:VisualElement style="flex-grow: 0; background-image: resource(&apos;Sprites/setting-lines&apos;); width: 80px; height: 80px; margin-right: 30px;" />
                <ui:Label text="Cấu hình trò chơi" />
            </ui:VisualElement>
            <UI.CustomElement.SelectNumberOfDigits name="select-numberof-digits" number-of-digits="4,5,6,7" style="margin-top: 50px;" />
        </ui:VisualElement>
        <ui:VisualElement name="header" style="flex-grow: 1; position: absolute; top: 100px; padding-right: 100px; padding-left: 100px; width: 100%; flex-direction: row;">
            <UI.CustomElement.CustomButton icon-image="project://database/Assets/Resources/Sprites/back.png?fileID=2800000&amp;guid=2268eb7fbdb26c54988801e57d76b882&amp;type=3#back" name="back-btn" style="width: 100px; height: 100px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; position: absolute;" />
            <ui:Label text="Tạo phòng mới" picking-mode="Ignore" style="position: relative; align-self: center; flex-grow: 1;" />
        </ui:VisualElement>
        <UI.CustomElement.CustomButton text="Tạo phòng ngay" name="create-room-btn" icon-image="project://database/Assets/Resources/Sprites/right-arrow.png?fileID=2800000&amp;guid=0cdf9f3322656684b983e28ddcb83e8f&amp;type=3#right-arrow" class="button" style="position: absolute; bottom: 150px; align-self: center; width: 900px;" />
        <ui:VisualElement name="loading-element" class="loading-element">
            <ui:Label text="Loading" style="margin-right: 20px; display: none;" />
            <UI.CustomElement.LoadingElement.LoadingDotEffect name="loading-effect" radius="10" number-of-dot="20" point-to-next-dot-start="3" style="flex-direction: row; flex-grow: 1; align-self: stretch;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
