.text-element {
    font-size: 60px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
    color: rgb(255, 255, 255);
    -unity-font-definition: resource('Fonts/toxigenesis bd');
}

#background {
    background-color: rgb(16, 22, 34);
    flex-grow: 1;
}

.button {
    height: 175px;
    transition-duration: 0.2s;
}

.button:active {
    scale: 1.1 1.1;
}

.button > Image {
    height: 175px;
    translate: -50px 0;
}

.loading-element {
    position: absolute;
    bottom: 150px;
    align-self: center;
    width: 900px;
    height: 175px;
    justify-content: center;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    display: flex;
    flex-direction: row;
    padding-right: 20px;
    padding-left: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-left-color: rgb(43, 53, 75);
    border-right-color: rgb(43, 53, 75);
    border-top-color: rgb(43, 53, 75);
    border-bottom-color: rgb(43, 53, 75);
    background-color: rgb(30, 42, 65);
    overflow: hidden;
}

#header {
    border-left-color: rgb(51, 65, 85);
    border-right-color: rgb(51, 65, 85);
    border-top-color: rgb(51, 65, 85);
    border-bottom-color: rgb(51, 65, 85);
    border-bottom-width: 2px;
    padding-bottom: 10px;
}
